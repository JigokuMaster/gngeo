TARGET		SMSPlus.exe
TARGETTYPE      exe
CAPABILITY 	ReadUserData WriteUserData //LocalServices NetworkServices
UID		0 0xE00054d3


epocstacksize	  0x8000
epocheapsize 0x5000 0x1000000

#include "../inc/SDLLauncher.hrh"

//#define OPENC OPENC
#define USE_ESDL USE_ESDL

MACRO LSB_FIRST HAVE_STB_TRUETYPE
//MACRO SYMBIAN_DIRECT_AUDIO
#ifdef USE_ESDL
MACRO S60V3 USE_ESDL
#endif


SOURCEPATH	../src

#ifdef USE_ESDL
SOURCE	SDLAppLauncher.cpp
SOURCE	Emu.cpp 
SOURCE	EmuCoreInterface.cpp
SOURCE	EmuUtils.cpp
SOURCE  DirectAudioStream.cpp
SOURCE  SdlUiToolkit.cpp
#else 
SOURCE		sdlexe.cpp
#endif 

SOURCEPATH	../src/sms_sdl-0.9.4a-r7.1/sdl
SOURCE saves.c
SOURCEPATH	../src/sms_sdl-0.9.4a-r7.1
SOURCE	render.c sms.c system.c vdp.c
SOURCE	cpu/z80.c sound/emu2413.c sound/sn76496.c


SOURCEPATH	..\data
START RESOURCE	SMSPlus.rss
HEADER
TARGETPATH	\resource\apps
END


SOURCEPATH	..\data
START RESOURCE	SMSPlus_reg.rss
#ifdef winscw
targetpath	\private\10003a3f\apps
#else
targetpath	\private\10003a3f\import\apps
#endif
END //resource

SYSTEMINCLUDE	\epoc32\include ..\inc
#ifdef OPENC
MACRO OPENC
SYSTEMINCLUDE	\epoc32\include\stdapis
#else
SYSTEMINCLUDE	\epoc32\include\libc
#endif

#ifdef USE_ESDL
SYSTEMINCLUDE	\epoc32\include\ESDL
#else 
SYSTEMINCLUDE	\epoc32\include\SDL
#endif 

USERINCLUDE ../src/sms_sdl-0.9.4a-r7.1
USERINCLUDE ../src/sms_sdl-0.9.4a-r7.1/cpu
USERINCLUDE ../src/sms_sdl-0.9.4a-r7.1/sound
USERINCLUDE ../src/sms_sdl-0.9.4a-r7.1/sdl
USERINCLUDE ../src



LIBRARY		euser.lib fbscli.lib ws32.lib  gdi.lib
LIBRARY		mediaclientaudiostream.lib

LIBRARY        avkon.lib efsrv.lib bafl.lib apparc.lib apgrfx.lib 
LIBRARY        eikcore.lib cone.lib bitgdi.lib scdv.lib hal.lib
LIBRARY        flogger.lib

#ifdef OPENC
LIBRARY   libc.lib
LIBRARY	  libm.lib
#else
LIBRARY	  estlib.lib 
#endif


#ifdef USE_ESDL
STATICLIBRARY 	ESDL.lib
#else 
STATICLIBRARY 	SDL.lib
#endif
