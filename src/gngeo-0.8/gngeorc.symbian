# GNGEO resource file for Symbian

# Where your rom (and bios) are?
rompath ./roms

blitter soft

effect none

# Have sound?
sound true

# Shown FPS
showfps false

# autoframeskip control
autoframeskip false

# enable joystick support ?
joystick false

# enable the 68k inline debuger? (disable the sound)
debug false

# Convert all tile at loading time (insted on the fly)

# Use PAL timing? (buggy)
pal false

# Sample rate
samplerate 11025

# country?
# japan, usa, europe
country europe

# system type? arcade or home
system arcade

# Key configuration
# please see SDL_keysym.h for key definition

p1control MENU=K32,A=K50,C=K52,COIN=K49,D=K54,B=K56,UP=K273,DOWN=K274,RIGHT=K275,LEFT=K276,START=K53,START=K13

